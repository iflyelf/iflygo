# 复制为 .env 后修改：cp .env.example .env
POSTGRES_DB=iflygo
POSTGRES_USER=iflygo
POSTGRES_PASSWORD=please-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
# 至少 32 字节随机值，例如：openssl rand -hex 32
SESSION_SECRET=please-change-to-a-random-32-byte-string
# 浏览器/客户端实际访问地址
SERVER_EXTERNAL_URL=http://127.0.0.1:8090
# TCP 中继对外地址（留空按 external_url + 8091 推断；反向代理时显式填写）
# TCP_RELAY_ADVERTISE=iflygo.example.com:8091
# 国内可用华为云 SWR 镜像
# IFLYGO_IMAGE=swr.cn-east-3.myhuaweicloud.com/iflyelf/iflygo:latest
