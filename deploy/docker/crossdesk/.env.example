# CrossDesk Server + Coturn 部署配置
# 复制为 .env 后填写；密钥用 openssl rand -hex 32 生成。
EXTERNAL_IP=203.0.113.10
INTERNAL_IP=10.0.0.5
CROSSDESK_SERVER_PORT=9099
CROSSDESK_IMAGE=crossdesk/crossdesk-server:latest
CROSSDESK_DATA_DIR=/var/lib/crossdesk
CROSSDESK_LOG_DIR=/var/log/crossdesk

CROSSDESK_LOG_RETENTION_DAYS=185
CROSSDESK_OFFLINE_RETENTION_DAYS=180
CROSSDESK_RETENTION_INTERVAL_SECONDS=3600

COTURN_IMAGE=coturn/coturn:4.17.2-r0-debian@sha256:aa68aab64a3b929d57fc2924c98ea447bf996cf8dade2508e7b71eaf23f1f14e
COTURN_PORT=3478
MIN_PORT=50000
MAX_PORT=60000
COTURN_REALM=crossdesk
COTURN_PUBLIC_HOST=
COTURN_AUTH_SECRET=
COTURN_CREDENTIAL_TTL_SECONDS=3600
CROSSDESK_ICE_SERVERS=
COTURN_STATELESS_NONCE_SECRET=
COTURN_LOG_LEVEL=warning
COTURN_MEMORY_LIMIT=512m

ADMIN_USERNAME=
ADMIN_PASSWORD=

CROSSDESK_NOFILE=32768
CROSSDESK_MAX_CONNECTIONS=8192
CROSSDESK_AUTH_WORKERS=2
CROSSDESK_AUTH_QUEUE_CAPACITY=4096
CROSSDESK_AUTH_SOURCE_CAPACITY=256
CROSSDESK_AUTH_SOURCE_PER_MINUTE=60
CROSSDESK_AUTH_TIMEOUT_SECONDS=600
