[Unit]
Description=iFlyGo Client Agent
Documentation=https://github.com/iflyelf/iflygo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/iflygo/client.env
ExecStart=/usr/local/bin/iflygo-client run \
  --state-dir /var/lib/iflygo-client \
  --config /etc/iflygo/client.yaml
Restart=always
RestartSec=3
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
