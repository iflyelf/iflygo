[Unit]
Description=iFlyGo Server
Documentation=https://github.com/iflyelf/iflygo
After=network-online.target
Wants=network-online.target
# 本机 PostgreSQL 时取消注释：
# After=postgresql.service

[Service]
Type=simple
WorkingDirectory=/var/lib/iflygo
EnvironmentFile=-/etc/iflygo/server.env
ExecStart=/usr/local/bin/iflygo-server -c /etc/iflygo/config.yaml
Restart=always
RestartSec=3
LimitNOFILE=65535
# 仅控制面（console）可删除下面两行；数据面角色（lighthouse/relay/edge/gateway）
# 需要创建 TUN、配置路由/NAT，edge 绑定 443 还需要 CAP_NET_BIND_SERVICE。
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
