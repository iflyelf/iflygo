# escape=`
#=================================================
# https://github.com/iflyelf/iflygo
# Lisence: MIT
# Author: iflyelf
# Blog: https://www.xiaonuo.live
#
# Windows 容器镜像 (用于在 Windows 容器环境中运行或提取二进制)
# 
# 使用方式:
#   1. Windows 容器部署: 在 Windows Server 上直接运行容器
#   2. 提取二进制: docker cp 复制 iflygo.exe 到宿主机使用
#=================================================

# ##############################################################################
# ***** 设置 iFlyGo 构建变量 (与 Dockerfile 保持一致的单一来源) *****
# 上游源码仓库(用于源码构建)
ARG IFLYGO_UPSTREAM_REPO=https://github.com/slackhq/nebula.git
# 上游版本(可在构建时通过 --build-arg IFLYGO_UPSTREAM_VERSION=vX.Y.Z 覆盖)
ARG IFLYGO_UPSTREAM_VERSION=v1.10.3
# 项目品牌(替换文本标识时使用)
ARG IFLYGO_BRAND=iflygo
# 项目品牌标题(用于显示)
ARG IFLYGO_BRAND_TITLE=iFlyGo
# GO 版本
ARG GO_VERSION=1.22
# 仓库地址
ARG REPO_URL=https://github.com/iflyelf/iflygo

ARG WINDOWS_BASE_TAG=ltsc2022

# 使用 Windows Server Core 作为基础镜像
FROM mcr.microsoft.com/windows/servercore:${WINDOWS_BASE_TAG}

# 作者与仓库信息
LABEL org.opencontainers.image.authors="iflyelf" `
      org.opencontainers.image.vendor="iflyelf" `
      org.opencontainers.image.title="iflygo-windows" `
      org.opencontainers.image.description="iFlyGo Windows 原生二进制容器镜像" `
      org.opencontainers.image.url="https://github.com/iflyelf/iflygo" `
      org.opencontainers.image.source="https://github.com/iflyelf/iflygo" `
      org.opencontainers.image.documentation="https://github.com/iflyelf/iflygo/blob/main/README.md"

# 创建工作目录
RUN powershell -Command `
    New-Item -ItemType Directory -Force -Path C:\iflygo\bin; `
    New-Item -ItemType Directory -Force -Path C:\iflygo\config; `
    New-Item -ItemType Directory -Force -Path C:\iflygo\logs

# 复制编译好的二进制文件 (由 GitHub Actions 编译后放入 ./bin 目录)
COPY bin/iflygo.exe C:\iflygo\bin\iflygo.exe
COPY bin/iflygo-cert.exe C:\iflygo\bin\iflygo-cert.exe

# 将 iflygo 添加到系统路径
RUN setx /M PATH "%PATH%;C:\iflygo\bin"

# 复制配置文件模板
COPY conf/server/config.yml C:\iflygo\config\server-config-template.yml
COPY conf/client/config.yml C:\iflygo\config\client-config-template.yml

# 复制启动脚本
COPY entrypoint.ps1 C:\iflygo\entrypoint.ps1

WORKDIR C:\iflygo

# 暴露 UDP 6688 端口 (iflygo 默认端口)
EXPOSE 6688/udp

# 默认入口点: 显示帮助信息并保持容器运行
CMD ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:\\iflygo\\entrypoint.ps1"]
